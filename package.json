{
  "name": "opendata-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "DEV_ALLOWED_HOSTS=${DEV_ALLOWED_HOSTS:-.local} vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/*.live.test.ts' --exclude '**/node_modules/**'",
    "test:live": "vitest run tests/exemplars.live.test.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.26",
    "@assistant-ui/react": "^0.15.27",
    "@assistant-ui/react-ai-sdk": "^1.4.17",
    "@assistant-ui/react-markdown": "^0.14.20",
    "@huggingface/transformers": "4.3.1",
    "ai": "^7.0.137",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
