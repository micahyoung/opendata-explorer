{
  "name": "opendata-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "DEV_ALLOWED_HOSTS=${DEV_ALLOWED_HOSTS:-.local} vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/*.live.test.ts' --exclude '**/node_modules/**'",
    "test:live": "vitest run tests/exemplars.live.test.ts",
    "eval": "BROWSER=none vitest --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.27",
    "@assistant-ui/react": "^0.15.28",
    "@assistant-ui/react-ai-sdk": "^1.4.17",
    "@assistant-ui/react-markdown": "^0.14.22",
    "@huggingface/transformers": "4.3.1",
    "ai": "^7.0.137",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-preview": "5.0.5",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
